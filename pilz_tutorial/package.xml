<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pilz_tutorial</name>
  <version>0.0.0</version>
  <description>The pilz_tutorial package - ROS2 Jazzy version</description>
  <maintainer email="bartlomiej.kulecki@put.poznan.pl">Bartlomiej Kulecki</maintainer>
  <license>Apache-2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>prbt_moveit_config</exec_depend>
  <exec_depend>prbt_support</exec_depend>
  <exec_depend>prbt_pg70_support</exec_depend>
  <exec_depend>prbt_hardware_support</exec_depend>
  <exec_depend>pilz_robot_programming</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
